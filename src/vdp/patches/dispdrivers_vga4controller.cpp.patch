+  if (mode == PaintMode::Set && glyph.width == 8 && glyphOptions.fillBackground && !glyphOptions.bold && !glyphOptions.italic &&
+      !glyphOptions.blank && !glyphOptions.underline && !glyphOptions.doubleWidth) {
+    auto const & ps = paintState();
+    const int gx = glyph.X + ps.origin.X, gy = glyph.Y + ps.origin.Y;
+    if (gx >= ps.absClippingRect.X1 && gx + 7 <= ps.absClippingRect.X2 && gy >= ps.absClippingRect.Y1 &&
