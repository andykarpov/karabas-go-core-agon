// <mutex> for the bare-metal VDP: the toolchain's libstdc++ has no threads (no gthreads), so
// std::mutex / lock_guard / unique_lock are made here over the cooperative scheduler (coop.h).
// A lock only waits (yields) while another task holds it; there is no preemption.
#pragma once
#include <utility>
#include "coop.h"

namespace std {

class mutex {
public:
    constexpr mutex() noexcept {}
    mutex(const mutex &) = delete;
    mutex &operator=(const mutex &) = delete;
    void lock() {
        while (m_locked) coop_yield();
        m_locked = true;
    }
    bool try_lock() {
        if (m_locked) return false;
        m_locked = true;
        return true;
    }
    void unlock() { m_locked = false; }
private:
    volatile bool m_locked = false;
};

class recursive_mutex {
public:
    constexpr recursive_mutex() noexcept {}
    recursive_mutex(const recursive_mutex &) = delete;
    recursive_mutex &operator=(const recursive_mutex &) = delete;
    void lock() {
        int me = coop_current();
        while (m_count && m_owner != me) coop_yield();
        m_owner = me;
        m_count++;
    }
    bool try_lock() {
        int me = coop_current();
        if (m_count && m_owner != me) return false;
        m_owner = me;
        m_count++;
        return true;
    }
    void unlock() { m_count--; }
private:
    int m_owner = -1;
    int m_count = 0;
};

struct defer_lock_t { explicit defer_lock_t() = default; };
struct try_to_lock_t { explicit try_to_lock_t() = default; };
struct adopt_lock_t { explicit adopt_lock_t() = default; };
inline constexpr defer_lock_t defer_lock{};
inline constexpr try_to_lock_t try_to_lock{};
inline constexpr adopt_lock_t adopt_lock{};

template <class M> class lock_guard {
public:
    using mutex_type = M;
    explicit lock_guard(M &m) : m_m(m) { m_m.lock(); }
    lock_guard(M &m, adopt_lock_t) : m_m(m) {}
    ~lock_guard() { m_m.unlock(); }
    lock_guard(const lock_guard &) = delete;
    lock_guard &operator=(const lock_guard &) = delete;
private:
    M &m_m;
};

template <class M> class unique_lock {
public:
    using mutex_type = M;
    unique_lock() noexcept {}
    explicit unique_lock(M &m) : m_m(&m) { m.lock(); m_owns = true; }
    unique_lock(M &m, defer_lock_t) noexcept : m_m(&m) {}
    unique_lock(M &m, try_to_lock_t) : m_m(&m), m_owns(m.try_lock()) {}
    unique_lock(M &m, adopt_lock_t) : m_m(&m), m_owns(true) {}
    ~unique_lock() { if (m_owns) m_m->unlock(); }
    unique_lock(const unique_lock &) = delete;
    unique_lock &operator=(const unique_lock &) = delete;
    unique_lock(unique_lock &&o) noexcept : m_m(o.m_m), m_owns(o.m_owns) { o.m_m = nullptr; o.m_owns = false; }
    unique_lock &operator=(unique_lock &&o) noexcept {
        if (m_owns) m_m->unlock();
        m_m = o.m_m; m_owns = o.m_owns;
        o.m_m = nullptr; o.m_owns = false;
        return *this;
    }
    void lock() { m_m->lock(); m_owns = true; }
    bool try_lock() { m_owns = m_m->try_lock(); return m_owns; }
    void unlock() { m_m->unlock(); m_owns = false; }
    M *release() noexcept { M *m = m_m; m_m = nullptr; m_owns = false; return m; }
    bool owns_lock() const noexcept { return m_owns; }
    explicit operator bool() const noexcept { return m_owns; }
    M *mutex() const noexcept { return m_m; }
private:
    M *m_m = nullptr;
    bool m_owns = false;
};

} // namespace std
